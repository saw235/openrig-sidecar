{
  "name": "openrig-sidecar",
  "version": "0.1.0",
  "description": "Antigravity Studio web companion and control plane for OpenRig fleets",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "openrig-sidecar": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');fs.mkdirSync('dist/vendor',{recursive:true});fs.copyFileSync(require.resolve('dagre/dist/dagre.min.js'),path.join('dist/vendor','dagre.min.js'));\"",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts"
  },
  "keywords": [
    "openrig",
    "antigravity",
    "multi-agent",
    "sidecar",
    "control-plane",
    "dashboard"
  ],
  "author": "Antigravity & OpenRig Team",
  "license": "Apache-2.0",
  "dependencies": {
    "dagre": "^0.8.5"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
